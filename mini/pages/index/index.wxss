page{background:#f4f7f4;color:#172a29;font-size:28rpx;line-height:1.55}
.page{padding:36rpx 26rpx 60rpx}.eyebrow{display:inline-block;color:#105e52;background:#e3efe8;padding:3rpx 14rpx;border-radius:18rpx;font-size:24rpx}.title{font-size:49rpx;font-weight:700;margin:12rpx 0}.lead{margin-bottom:25rpx}.muted{color:#536860}.hint{font-size:24rpx;margin:12rpx 0}.card{background:white;border:1rpx solid #dae5de;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx}.heading{font-size:31rpx;font-weight:700;margin-bottom:14rpx}.input{border:1rpx solid #d4e0d7;border-radius:10rpx;background:#f7faf7;padding:13rpx 17rpx}.switch{display:flex;align-items:center;gap:14rpx;margin:17rpx 0}button{background:#105e52;color:white;font-size:28rpx;border-radius:10rpx;margin-top:14rpx}button.secondary{background:#edf4ee;color:#105e52}.record{padding:15rpx;margin:14rpx 0;border:1rpx solid #dae5de;border-radius:10rpx}.actions{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #dae5de}.error{color:#9b351f;margin-top:14rpx}

.sample-input{margin-top:14rpx;height:68rpx}
