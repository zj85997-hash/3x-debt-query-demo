<view class="page">
  <view class="topline">
    <view class="steps">
      <view class="step {{step === 1 ? 'on' : 'done'}}">1 核验身份</view>
      <view class="step {{step === 2 ? 'on' : step > 2 ? 'done' : ''}}">2 查看结果</view>
      <view class="step {{step === 3 ? 'on' : ''}}">3 人工协助</view>
    </view>
    <view wx:if="{{demo}}" class="env">演示环境 · 虚构数据</view>
  </view>

  <!-- 第一步：本人核验 -->
  <block wx:if="{{step === 1}}">
    <view class="hero">
      <view class="h1">查询本人债权信息</view>
      <view class="lead">核对已授权的债权台账与债权转让记录，查清楚"我的这笔欠款现在归谁、该联系谁"。</view>
      <view class="trust"><text>仅限本人查询</text><text>不保存明文证件号</text><text>每次查询留痕</text></view>
    </view>
    <view class="card">
      <view class="h2">本人身份核验</view>
      <view class="label">姓名</view>
      <input class="input" placeholder="与证件一致的姓名" maxlength="20" value="{{name}}" bindinput="onName" />
      <view class="label">居民身份证号码</view>
      <input class="input mono" placeholder="18 位证件号码" maxlength="18" type="idcard" value="{{idNo}}" bindinput="onIdNo" />
      <checkbox-group bindchange="onAccept" class="check">
        <label><checkbox value="yes" checked="{{accepted}}" color="#123a8f" />我已阅读并同意</label>
        <text class="link" bindtap="togglePolicy">《查询说明与授权》</text>
      </checkbox-group>
      <view wx:if="{{showPolicy && policy}}" class="policy">
        <view wx:for="{{policy.items}}" wx:key="*this" class="policy-item">{{index + 1}}. {{item}}</view>
        <view class="muted small">文本版本 {{policy.version}}</view>
      </view>
      <view wx:if="{{error}}" class="error">{{error}}</view>
      <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || !ready}}">{{busy && busyText ? busyText : '核验并查询'}}</button>
      <view wx:if="{{demo}}" class="muted small center">演示环境只接受下方"演示身份"，请勿输入真实姓名或证件号码。</view>
    </view>
    <view class="card" wx:if="{{personas.length}}">
      <view class="h2">演示身份 <text class="muted small">点选即可自动填写</text></view>
      <view class="personas">
        <view wx:for="{{personas}}" wx:key="id" class="persona" data-i="{{index}}" bindtap="fillPersona">
          <view class="persona-title">{{item.label}}</view>
          <view class="muted small">{{item.hint}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 第二、三步：结果与人工协助 -->
  <block wx:else>
    <view class="identity">
      <view>
        <view class="who">{{profile.nameMasked}}</view>
        <view class="muted small mono">{{profile.idMasked}}</view>
      </view>
      <view class="pill ok">已核验</view>
    </view>

    <view class="card">
      <view class="result-head">
        <view class="h2">{{head[1]}}</view>
        <view class="pill {{result.state}}">{{head[0]}}</view>
      </view>
      <view class="desc">{{head[2]}}</view>

      <view wx:for="{{result.records}}" wx:key="loanDate" class="record">
        <view class="record-title">债务 {{result.records.length > 1 ? index + 1 : ''}}<text class="muted small">数据时点 {{item.asOf}}</text></view>
        <view class="row"><text>债权主体</text><text>{{item.holder}}</text></view>
        <view class="row"><text>原贷款方</text><text>{{item.originator}}</text></view>
        <view class="row"><text>贷款日期</text><text>{{item.loanDate}}</text></view>
        <view class="row"><text>贷款本金</text><text class="mono">{{item.principalText}}</text></view>
        <view class="row"><text>欠款本息</text><text class="mono">{{item.balanceText}}</text></view>
      </view>
      <view wx:if="{{result.state === 'own'}}" class="note">金额为数据时点的台账记录，实际应还金额以服务机构复核为准。</view>

      <view wx:for="{{result.transfers}}" wx:key="recordId" class="record">
        <view class="record-title">转让记录 {{result.transfers.length > 1 ? index + 1 : ''}}<text wx:if="{{item.detail}}" class="pill ok">已解锁</text></view>
        <block wx:if="{{item.detail}}">
          <view class="row"><text>欠款人</text><text>{{item.detail.debtor}}</text></view>
          <view class="row"><text>债权出让方（贷款方）</text><text>{{item.detail.transferor}}</text></view>
          <view class="row"><text>债权受让方（新债权人）</text><text>{{item.detail.transferee}}</text></view>
          <view class="row"><text>转让日期</text><text>{{item.detail.transferDate}}</text></view>
          <view class="row"><text>转让金额</text><text class="mono">{{item.detail.amountText}}</text></view>
          <view class="row"><text>受让方联系方式</text><text>{{item.detail.contact}}</text></view>
        </block>
        <block wx:else>
          <view class="row"><text>是否已转让</text><text>是</text></view>
          <view class="row"><text>转让日期</text><text>{{item.transferDate}}</text></view>
          <view class="row"><text>转让金额</text><text class="mono">{{item.amountText}}</text></view>
          <view class="row locked"><text>出让方 / 受让方 / 联系方式</text><text>付费后可见</text></view>
          <button class="pay" size="mini" data-i="{{index}}" bindtap="unlock" disabled="{{busy}}">{{item.unlocked ? '查看完整信息' : price + ' 解锁'}}</button>
        </block>
      </view>
      <view wx:if="{{result.state === 'history'}}" class="note">转让记录反映的是历史事件，当前债权状态请以受让方答复为准。</view>
      <view wx:if="{{result.state === 'candidate' && result.ambiguous}}" class="note">现有公告资料不足以区分相关记录，系统不会任选其一作为你的结果。</view>
      <button wx:if="{{result.state === 'unavailable'}}" class="soft" bindtap="retry" disabled="{{busy}}">重新查询</button>
      <view wx:if="{{result.queryId}}" class="muted small mono">查询编号 {{result.queryId}}</view>
    </view>

    <view class="card" wx:if="{{result.state !== 'unavailable' && !booked}}">
      <view class="h2">申请人工协助</view>
      <view class="desc">{{contactPolicy}}</view>
      <view class="windows">
        <view wx:for="{{windows}}" wx:key="*this" class="window {{windowIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="onWindow">{{item}}</view>
      </view>
      <checkbox-group bindchange="onContactAccept" class="check">
        <label><checkbox value="yes" checked="{{contactAccepted}}" color="#123a8f" />我同意工作人员在所选时段与我联系（可随时撤回）</label>
      </checkbox-group>
      <button class="soft" bindtap="book" disabled="{{busy}}">提交预约</button>
    </view>

    <view class="card" wx:if="{{tickets.length}}">
      <view class="h2">我的预约</view>
      <view wx:for="{{tickets}}" wx:key="id" class="ticket">
        <view>
          <view>{{item.timeWindow}}</view>
          <view class="muted small">{{item.timeText}}</view>
        </view>
        <view class="ticket-side">
          <text class="pill {{item.status}}">{{item.statusText}}</text>
          <button wx:if="{{item.status === 'pending'}}" size="mini" class="ghost" data-id="{{item.id}}" bindtap="withdraw" disabled="{{busy}}">取消</button>
        </view>
      </view>
    </view>
    <button class="ghost" bindtap="restart">退出并重新查询</button>
  </block>

  <view class="foot muted small">
    <view wx:if="{{operator}}">运营主体：{{operator}}</view>
    <view>本页面不代表任何官方登记或征信机构。查询结果限于已收录范围，未查到不代表不存在欠款或未发生转让。</view>
  </view>

  <!-- 收银台（演示环境为模拟支付） -->
  <view class="mask" wx:if="{{cashier}}" catchtap="closeCashier">
    <view class="sheet" catchtap="">
      <view class="h2">确认支付</view>
      <view wx:if="{{demo}}" class="demo-banner">模拟收银台 · 演示环境不会产生真实扣款</view>
      <view class="amount">{{cashier.amountText}}</view>
      <view class="desc center">债权转让详情解锁</view>
      <view class="fields"><view wx:for="{{cashier.fields}}" wx:key="*this">· {{item}}</view></view>
      <button class="pay block" bindtap="pay">确认支付{{demo ? '（模拟）' : ''}}</button>
      <view class="center small pay-state">{{payState}}</view>
    </view>
  </view>
</view>
