# 配置项清单（全部通过环境变量注入，代码里的唯一读取点是 src/config.mjs）。
# 复制为 .env 后填写。标 [必填] 的没有默认值；其余为默认值，按需调整。

# ── 运行模式
APP_MODE=demo                 # demo：只接受 99 开头的虚构证件号、开放模拟支付；prod：关闭全部模拟入口
HOST=0.0.0.0
PORT=8800
API_WORKERS=4                 # 每个节点的 API 进程数，建议 = CPU 核数（留 1 核给后台进程）
NODE_NAME=node1               # 节点名，出现在日志与大盘里
TRUST_PROXY=0                 # 前面有负载均衡时，填它的回源 IP/网段（逗号分隔，以云厂商文档为准）；直接对公网时必须为 0。不支持"信任全部"
DRAIN_GRACE_MS=8000           # 下线宽限期，应不小于负载均衡摘除实例所需时间
LOG_LEVEL=warn                # debug / info / warn / error
ACCESS_LOG_SAMPLE=0.01        # 正常请求访问日志采样率（错误与慢请求始终记录）

# ── 密钥 [必填]（各自独立的随机值，至少 32 个字符；生产环境由 KMS / 密钥管理服务下发）
TOKEN_SECRET=
ID_HASH_KEY=                  # 证件号盲索引密钥：一旦有数据入库就不能更换，必须单独备份
PAY_NOTIFY_SECRET=
OPS_TOKEN=

# ── MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dq_app
DB_PASSWORD=
DB_NAME=debt_query
DB_POOL_SIZE=10               # 每个 API 进程的连接数。全节点连接数 = (API_WORKERS + 1) × DB_POOL_SIZE，须小于数据库 max_connections
DB_QUEUE_MAX=400
DB_QUEUE_WAIT_MS=800
DB_QUERY_TIMEOUT_MS=1500
# DB_CA_FILE=/path/to/ca.pem  # 云数据库启用 TLS 时填写

# ── Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=dq:
REDIS_COMMAND_TIMEOUT_MS=300

# ── 第三方：实名核验与支付
VERIFY_PROVIDER_URL=http://127.0.0.1:8810
VERIFY_CONCURRENCY=40         # 每进程并发上限 = 供应商并发配额 ÷ 全部 API 进程数
VERIFY_QUEUE_MAX=400
VERIFY_QUEUE_WAIT_MS=3000
VERIFY_TIMEOUT_MS=2500
VERIFY_DAILY_BUDGET=200000    # 每日核验次数预算（成本熔断）
PAY_PROVIDER_URL=http://127.0.0.1:8810
PAY_NOTIFY_URL=http://127.0.0.1:8800/api/v1/pay/notify
UNLOCK_PRICE_FEN=990
ORDER_TTL_SEC=900

# ── 过载保护
MAX_IN_FLIGHT=600             # 每进程普通请求在途上限
CRITICAL_RESERVE=200          # 为支付回调、订单状态额外预留
LOOP_LAG_SHED_MS=250          # 事件循环延迟超过该值时拒绝普通请求

# ── 频率限制（桶容量 / 时间窗内补充量）
RL_SESSION_IP_BURST=30
RL_SESSION_IP_PER_MIN=30
RL_VERIFY_SID_BURST=5
RL_VERIFY_SID_PER_10MIN=5
RL_VERIFY_IP_BURST=60
RL_VERIFY_IP_PER_10MIN=60
RL_VERIFY_ID_BURST=10
RL_VERIFY_ID_PER_DAY=10
RL_QUERY_SUB_BURST=10
RL_QUERY_SUB_PER_MIN=10
RL_WRITE_SUB_BURST=20
RL_WRITE_SUB_PER_HOUR=60

# ── 其他
POLICY_VERSION=query-policy-2026-11   # 授权文本版本；文本一改就换版本号，旧会话需重新同意
QUERY_RESULT_CACHE_SEC=30
SESSION_ANON_TTL_SEC=3600
SESSION_VERIFIED_TTL_SEC=1800
